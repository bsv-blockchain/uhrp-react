{
  "name": "@bsv/uhrp-react",
  "version": "2.0.0",
  "description": "UHRP-enabled React components for images, video, and audio",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "PATENTS",
    "NOTICE",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bsv-blockchain/uhrp-react.git"
  },
  "author": "BSV Association",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "postbuild": "echo 'Build complete!'",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@bsv/sdk": "^4.1.2",
    "zustand": "^4.5.6"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  }
}
